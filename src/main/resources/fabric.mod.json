{
  "schemaVersion": 1,
  "id": "barium",
  "version": "${version}",
  "name": "Barium",
  "description": "Mod de otimização para Minecraft 26.3",
  "authors": [
    "PedrixzZDev"
  ],
  "contact": {
    "homepage": "https://github.com/BariumMC/barium",
    "sources": "https://github.com/BariumMC/barium"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.barium.BariumMod"
    ],
    "client": [
      "com.barium.client.BariumClient"
    ]
  },
  "mixins": [
    {
      "config": "barium.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
